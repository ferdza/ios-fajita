-      if (sr != 0 || sb.planes > 1 || sb.bytes_per_row == 0) {
+      /* fajita: QuartzCore's display surfaces with Metal are 'b3a8' (RGB10A8_2P_XR10[_sRGB], 550/551): two planes, a colour
+       * plane of 4 bytes a pixel, then an A8 plane. The kernel's top-level offset and pitch are the colour plane's. Any
+       * 4-byte format may read or write it: QuartzCore reads the previous frame back through other formats to keep the
+       * undamaged part of the screen, and refusing that left those areas showing older frames. bgmtl refuses plane != 0. */
+      bool colour_plane = shape->pixel_format == 550 || shape->pixel_format == 551 || util_format_get_blocksize(fmt->pipe) == 4;
+      if (sr == 0 && sb.planes > 1 && !colour_plane) {
+         say(why, why_size, "IOSurface %d has %u planes and MTLPixelFormat %u (%s) is not 4 bytes a texel: only the colour plane is "
+                            "imported", import->id, sb.planes, shape->pixel_format, fmt->name);
+         free(texture);
+         return NULL;
+      }
+      if (sr != 0 || (sb.planes > 1 && !colour_plane) || sb.bytes_per_row == 0) {
          say(why, why_size, "the kernel would not describe IOSurface %d (error %d, planes %u, %u bytes a row): it knows nothing of an ID that "
                             "was never made shareable", import->id, sr, sb.planes, sb.bytes_per_row);
          free(texture);
