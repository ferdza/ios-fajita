diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 00568d3..ec99bf0 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -6881,7 +6881,13 @@ void
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	/*
+	 * SWEET: ptoa(), not pp << PAGE_SHIFT. ppnum_t is 32 bits, so the shift dropped bit 32 of every
+	 * page above 4 GiB and phystokv panicked on the result ("illegal PA" below gPhysBase on any
+	 * cache-mode change: write-combined maps, kmem_alloc_contig). Fix from ios-flame 0115 (MIT),
+	 * found via tre4surehunter9/ios-fajita 0098.
+	 */
+	flush_dcache((vm_offset_t) ptoa(pp), PAGE_SIZE, TRUE);
 }
 
 #if CONFIG_COREDUMP
