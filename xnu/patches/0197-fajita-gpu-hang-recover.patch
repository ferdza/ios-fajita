+/*
+ * GPU hang recovery (EXPERIMENTAL; boot-arg gpurecover=1, default off).
+ *
+ * A wedged CP never retires its fence, so the submit path's ring-drain wait
+ * times out and - without this - that frame and every WAIT_FENCE behind it are
+ * stuck until the user reboots (the "freeze"). This resets the GPU core and
+ * brings the CP back so the client resubmits.
+ *
+ * Modelled on msm's a6xx_recover and Snapintosh's adreno_recover, reduced to
+ * this single-ring, GMU-up port and adapted to a630:
+ *   1. halt the SQE and the VBIF so no in-flight GPU write lands after the reset
+ *   2. RBBM soft-reset the GPU core (the GMU and its clocks stay up: a CP hang
+ *      does not wedge the GMU, so the heavier GMU SYSRESET is not used)
+ *   3. re-run the CP hardware init and CP_ME_INIT (as stage 7a)
+ *   4. reload the zap shader to leave secure mode again (as stage 7c)
+ *   5. advance the fence slot to the last submitted sequence so every waiter
+ *      unblocks; the lost work is declared complete and the client resubmits it
+ *
+ * Fails closed: any step that does not settle marks the GPU lost - no further
+ * submit, no further recovery - so a reset that does not take degrades to
+ * today's behaviour (a reboot) instead of a reset loop. Rate-limited to
+ * GPU_RECOVER_MAX resets per boot for the same reason.
+ *
+ * The VBIF halt uses public a6xx.xml offsets but is best-effort: if the
+ * acknowledge does not arrive within the poll it proceeds to the reset anyway,
+ * so a wrong client mask cannot block recovery. A GMU-mediated reset with a
+ * full bus-transaction drain is the hardening path if this proves insufficient
+ * on hardware.
+ */
+bool
+sweet_gpu_recover(const char *why)
+{
+	vm_offset_t core = gpu_core, g = gpu_blob;
+
+	if (!gpu_recover_on || !gpu_live || gpu_lost || core == 0 || g == 0) {
+		return false;
+	}
+	if (gpu_recover_tries >= GPU_RECOVER_MAX) {
+		printf("SWEET GPU: recover (%s): %u resets reached, GPU lost\n", why, gpu_recover_tries);
+		gpu_lost = true;
+		return false;
+	}
+	gpu_recover_tries++;
+	printf("SWEET GPU: recover (%s): reset %u, fence slot %u last submitted %u\n", why,
+	    gpu_recover_tries, *(volatile uint32_t *)(g + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE),
+	    gpu_cp_seq);
+
+	/* 1. quiesce: stop the SQE, then halt the VBIF AXI clients (best effort). */
+	gpu_cp_wr(core, A6XX_CP_SQE_CNTL, 0);
+	gpu_cp_wr(core, A6XX_VBIF_XIN_HALT_CTRL0, A6XX_VBIF_XIN_HALT_MASK);
+	for (unsigned i = 0; i < 100; i++) {
+		if ((gpu_cp_rd(core, A6XX_VBIF_XIN_HALT_CTRL1) & A6XX_VBIF_XIN_HALT_MASK) ==
+		    A6XX_VBIF_XIN_HALT_MASK) {
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	gpu_cp_wr(core, A6XX_VBIF_XIN_HALT_CTRL0, 0);
+
+	/* 2. RBBM soft reset of the GPU core; the GMU keeps the rails and clocks up. */
+	gpu_cp_wr(core, A6XX_RBBM_SW_RESET_CMD, 1);
+	gpu_wait_ms(1);
+	gpu_cp_wr(core, A6XX_RBBM_SW_RESET_CMD, 0);
+	gpu_wait_ms(1);
+
+	/* 3. the CP comes back exactly as at boot. */
+	if (!gpu_cp_hw_init(core) || !gpu_cp_start(core, g + GPU_CP_RING)) {
+		printf("SWEET GPU: recover (%s): CP did not re-init, GPU lost\n", why);
+		gpu_lost = true;
+		return false;
+	}
+
+	/* 4. the reset dropped the GPU back into secure mode; the zap shader leaves it. */
+	if (!gpu_zap_load(g, gpu_gmem_pa)) {
+		printf("SWEET GPU: recover (%s): zap reload failed, GPU lost\n", why);
+		gpu_lost = true;
+		return false;
+	}
+
+	/* 5. retire the lost work: the CP writes rising sequences from here, and every
+	 *    waiter on an already-submitted fence now sees it done and unblocks. */
+	*(volatile uint32_t *)(g + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE) = gpu_cp_seq;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	printf("SWEET GPU: recover (%s): GPU live again at fence %u\n", why, gpu_cp_seq);
+	return true;
+}
