diff --git a/iokit/Kernel/arm/SweetAdreno.cpp b/iokit/Kernel/arm/SweetAdreno.cpp
index ac0cb66..1675129 100644
--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -452,7 +452,10 @@ SweetAdrenoUserClient::gemNew(struct sweet_msm_gem_new *r)
 		 * IOSurfaces (inTaskWithOptions, no contiguity, no physical mask). Those pages are valid
 		 * for pmap and the GPU already renders into them through SURFACE_BO; only contiguous
 		 * allocations (kmem_alloc_contig) returned the pages below gPhysBase that panic.
-		 * Cacheable: submit, CPU_PREP and BO_SYNC clean them through gem_flush().
+		 * Write-combined (kIOMapWriteCombineCache), like the arena and like NativeAdreno's
+		 * system-memory BOs: no per-line cache maintenance per submission, only a barrier in
+		 * gem_flush() to drain the write-combine buffer. The per-line flush over a whole spilled
+		 * framebuffer each submission was the "PowerPoint" slowness.
 		 */
 		IOLockLock(gAdrenoLock);
 		bool room = gAdrenoVmBytes + size <= GEM_VM_MAX;
@@ -461,7 +464,7 @@ SweetAdrenoUserClient::gemNew(struct sweet_msm_gem_new *r)
 		}
 		IOLockUnlock(gAdrenoLock);
 		IOBufferMemoryDescriptor *vm = room ? IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
-		    kIODirectionInOut | kIOMemoryKernelUserShared, size, page_size) : NULL;
+		    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache, size, page_size) : NULL;
 		if (vm == NULL) {
 			IOLockLock(gAdrenoLock);
 			if (room) {
@@ -600,6 +603,14 @@ gem_flush(struct sweet_gem *g, uint64_t off, uint64_t len)
 	}
 	if (g->pa != 0) {
 		flush_dcache64((addr64_t)(g->pa + off), (unsigned)len, TRUE);
+	} else if (g->buf != NULL) {
+		/*
+		 * Ordinary GEM BOs are write-combined (kIOMapWriteCombineCache), like the arena: there are
+		 * no cache lines to clean, so the per-line flush over the whole BO - the cost that made the
+		 * spilled framebuffers a "PowerPoint" - becomes one barrier that drains the write-combine
+		 * buffer, so CPU stores reach memory before the GPU reads them.
+		 */
+		__asm__ volatile ("dsb sy" ::: "memory");
 	} else if (g->kva != NULL) {
 		flush_dcache64((addr64_t)(uintptr_t)(g->kva + off), (unsigned)len, FALSE);
 	}
