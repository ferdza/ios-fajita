@@ -492,7 +492,7 @@ static uint32_t gpu_arena_used;
 
 /* GPU address space (stage 8f): all of L1[2], first fit, a guard page between buffers. */
 #define GPU_VA_BYTES       0x40000000ull        /* 1 GiB */
-#define GPU_VA_EXTENTS     32u
+#define GPU_VA_EXTENTS     512u
 #define GPU_PTE_TABLES     512u                 /* 2 MiB each: the whole 1 GiB client range */
 
 struct gpu_va_extent {
@@ -1744,10 +1744,33 @@ gpu_va_take(uint64_t size, uint64_t *off)
 	return true;
 }
 
+/* BEGIN va give (host-tested: tools/tests/gpu-va-test.c) */
+/*
+ * Return [off, off+size) plus its guard page and merge it with free neighbours: without merging
+ * the table filled after a few hundred frees (QuartzCore maps its screen surfaces again and
+ * again) and every later free was lost, until a 14 MB surface found no room anywhere.
+ */
 static void
 gpu_va_give(uint64_t off, uint64_t size)
 {
 	size += 0x1000;                 /* the guard page goes with it */
+	for (bool merged = true; merged;) {
+		merged = false;
+		for (unsigned i = 0; i < GPU_VA_EXTENTS; i++) {
+			struct gpu_va_extent *e = &gpu_va_free[i];
+			if (e->size == 0) {
+				continue;
+			}
+			if (e->off + e->size == off) {
+				off = e->off;
+			} else if (off + size != e->off) {
+				continue;
+			}
+			size += e->size;
+			e->size = 0;
+			merged = true;
+		}
+	}
 	for (unsigned i = 0; i < GPU_VA_EXTENTS; i++) {
 		if (gpu_va_free[i].size == 0) {
 			gpu_va_free[i].off = off;
@@ -1758,6 +1781,7 @@ gpu_va_give(uint64_t off, uint64_t size)
 	printf("SWEET GPU: va free table full, %#llx (%llu bytes) left unused\n",
 	    (unsigned long long)(GPU_VA_BASE + off), (unsigned long long)size);
 }
+/* END va give */
 
