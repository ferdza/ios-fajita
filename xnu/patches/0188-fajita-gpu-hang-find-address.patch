+/*
+ * Hang diagnostics (lock held): which of this client's BOs hold the faulting address, or
+ * its high word next to a nearby low word, and which BO the low 32 bits would land in.
+ * The GPU computed the address from memory somewhere; this names the buffer and offset.
+ */
+void
+SweetAdrenoUserClient::findAddress(uint64_t far)
+{
+	uint32_t hi = (uint32_t)(far >> 32), lo = (uint32_t)far;
+	unsigned hits = 0;
+
+	IOLog("SWEET GPU FIND: looking for %#llx (hi %#x lo %#x) in this client's BOs\n", far, hi, lo);
+	for (uint32_t i = 0; i < GEM_MAX; i++) {
+		struct sweet_gem *g = &fGems[i];
+		if (g->md == NULL) {
+			continue;
+		}
+		bool contains = (g->iova <= lo && lo < g->iova + g->size) ||
+		    (g->iova <= (lo | 0x80000000u) && (lo | 0x80000000u) < g->iova + g->size);
+		if (contains) {
+			IOLog("SWEET GPU FIND: lo %#x (or %#x) falls in bo %u iova %#llx size %llu%s\n", lo, lo | 0x80000000u,
+			    i + 1, g->iova, g->size, g->surface ? " (surface)" : "");
+		}
+		if (g->kva == NULL || hi == 0) {
+			continue;
+		}
+		volatile uint32_t *p = (volatile uint32_t *)(void *)g->kva;
+		uint64_t n = g->size / 4;
+		for (uint64_t k = 1; k < n && hits < 8; k++) {
+			if (p[k] != hi) {
+				continue;
+			}
+			uint32_t d = p[k - 1] > lo ? p[k - 1] - lo : lo - p[k - 1];
+			if (d > 0x01000000u) {
+				continue;
+			}
+			hits++;
+			uint64_t a = k >= 8 ? k - 8 : 0, b = k + 8 < n ? k + 8 : n - 1;
+			IOLog("SWEET GPU FIND: bo %u iova %#llx size %llu%s: pair at +%#llx (iova %#llx) = %#x %#x\n", i + 1, g->iova,
+			    g->size, g->surface ? " (surface)" : "", (k - 1) * 4, g->iova + (k - 1) * 4, p[k - 1], p[k]);
+			for (uint64_t j = a; j <= b; j += 4) {
+				IOLog("SWEET GPU FIND:   +%#06llx: %#010x %#010x %#010x %#010x\n", j * 4, p[j],
+				    j + 1 <= b ? p[j + 1] : 0, j + 2 <= b ? p[j + 2] : 0, j + 3 <= b ? p[j + 3] : 0);
+			}
+		}
+	}
+	IOLog("SWEET GPU FIND: %u pair(s) found\n", hits);
+}
