+/*
+ * Clean+invalidate [off, off+len) of a BO through the linear map. Arena BOs are one physical
+ * run; ordinary-memory and surface BOs are walked segment by segment (the pages are not
+ * contiguous). flush_dcache64() works by physical address, so it reaches every alias.
+ */
+static void
+gem_flush(struct sweet_gem *g, uint64_t off, uint64_t len)
+{
+	if (len == 0 || off >= g->size) {
+		return;
+	}
+	if (len > g->size - off) {
+		len = g->size - off;
+	}
+	if (g->pa != 0) {
+		flush_dcache64((addr64_t)(g->pa + off), (unsigned)len, TRUE);
+		return;
+	}
+	while (len > 0) {
+		IOByteCount seg = 0;
+		addr64_t pa = g->md->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+		if (pa == 0 || seg == 0) {
+			return;
+		}
+		uint64_t n = seg < len ? seg : len;
+		flush_dcache64(pa, (unsigned)n, TRUE);
+		off += n;
+		len -= n;
+	}
+}
