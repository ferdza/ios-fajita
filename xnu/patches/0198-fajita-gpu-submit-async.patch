 /* osfmk/arm64/caches_asm.s: clean the dcache for a physical range via the linear map. */
@@ -945,6 +946,15 @@ SweetAdrenoUserClient::waitFenceCall(struct sweet_msm_wait_fence *r)
 			if (far != 0) {
 				findAddress(far);       /* far == 1: no SMMU fault, only the IB dumps say anything */
