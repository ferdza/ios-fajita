diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index f077ac8..b85b0cf 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1977,6 +1977,33 @@ sweet_gpu_cache_sync(void *va, size_t len)
 
 bool sweet_gpu_recover(const char *why);      /* defined below, before the bring-up */
 
+/*
+ * Ring backpressure. sweet_gpu_submit no longer drains the ring to empty on
+ * every call (that serialised the CPU behind the GPU - the "PowerPoint"), so a
+ * submit can now find the ring still holding earlier, unretired work. Block
+ * until the CP's RPTR has freed room for `need` dwords, bounded like the drain
+ * wait so a wedged CP is caught here too. gpu_ring_emit wraps blindly, so
+ * without this a fast client would lap the CP and overwrite unread packets.
+ */
+static bool
+gpu_ring_reserve(vm_offset_t core, unsigned need)
+{
+	const unsigned size = GPU_CP_RING_BYTES / 4u;
+
+	if (need >= size) {
+		return false;                           /* a submit larger than the ring never fits */
+	}
+	for (unsigned i = 0; i < GPU_RING_IDLE_MS; i++) {
+		unsigned rptr = gpu_cp_rd(core, A6XX_CP_RB_RPTR);
+		unsigned used = (gpu_cp_wptr - rptr) % size;    /* dwords the CP has not yet consumed */
+		if (used + need < size - 1u) {                  /* keep a slot: wptr must not meet rptr */
+			return true;
+		}
+		gpu_wait_ms(1);
+	}
+	return false;
+}
+
 /* One CP_INDIRECT_BUFFER per command buffer, then the CACHE_FLUSH_TS fence - Linux's
  * a6xx_submit tail, which is what their submit path hands us. */
 uint32_t
@@ -1985,6 +2012,11 @@ sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned co
 	if (!gpu_live || ib_iova == NULL || ib_dwords == NULL || count == 0) {
 		return 0;
 	}
+	/* 4 dwords for the CCU invalidate, 4 per IB, 5 for the CACHE_FLUSH_TS fence. */
+	if (!gpu_ring_reserve(gpu_core, 9u + count * 4u)) {
+		sweet_gpu_recover("ring full");
+		return 0;
+	}
 	/*
 	 * As msm's a6xx_submit: invalidate the CCU's depth and colour caches first. Mesa relies on the
 	 * kernel for this between submissions; without it a render target read back as a texture can
@@ -2008,12 +2040,13 @@ sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned co
 	gpu_ring_emit(gpu_blob + GPU_CP_RING, ++gpu_cp_seq);
 	gpu_ring_flush(gpu_core, gpu_cp_wptr);
 
-	if (!gpu_ring_wait_idle(gpu_core, "submit")) {
-		/* The CP wedged mid-frame. Try to reset it so the client can resubmit;
-		 * without recovery this frame and every waiter behind it hang (the freeze). */
-		sweet_gpu_recover("submit drain");
-		return 0;
-	}
+	/*
+	 * Return without draining the ring: the GPU runs this submission while the
+	 * CPU builds the next frame. The client synchronises through CPU_PREP /
+	 * WAIT_FENCE on the sequence returned here (SweetAdreno.cpp), so the old
+	 * wait-idle was pure serialisation. A wedge is caught by the next submit's
+	 * reserve, by WAIT_FENCE's timeout, or by the present path - each recovers.
+	 */
 	return gpu_cp_seq;
 }
 
