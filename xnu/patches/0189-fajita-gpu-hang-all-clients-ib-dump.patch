  * its high word next to a nearby low word, and which BO the low 32 bits would land in.
  * The GPU computed the address from memory somewhere; this names the buffer and offset.
  */
+/* The BO (any client) whose GPU range holds va, or NULL. Lock held. */
+static struct sweet_gem *
+gem_at(uint64_t va, unsigned *client, uint32_t *handle)
+{
+	for (unsigned c = 0; c < CLIENT_LIST_MAX; c++) {
+		SweetAdrenoUserClient *uc = gClientList[c];
+		if (uc == NULL || uc->gemTable() == NULL) {
+			continue;
+		}
+		for (uint32_t i = 0; i < GEM_MAX; i++) {
+			struct sweet_gem *g = &uc->gemTable()[i];
+			if (g->md != NULL && g->iova != IOVA_UNSET && g->iova <= va && va < g->iova + g->size) {
+				*client = c;
+				*handle = i + 1;
+				return g;
+			}
+		}
+	}
+	return NULL;
+}
+
+/* Up to 256 dwords at va, 8 a line, from whichever client's BO holds it. Lock held. */
+static void
+dump_dwords(const char *what, uint64_t va)
+{
+	unsigned c;
+	uint32_t h;
+	struct sweet_gem *g = va != 0 ? gem_at(va, &c, &h) : NULL;
+
+	if (g == NULL || g->kva == NULL) {
+		IOLog("SWEET GPU DUMP %s %#llx: in no mapped BO\n", what, va);
+		return;
+	}
+	uint64_t off = va - g->iova, n = (g->size - off) / 4;
+	if (n > 256) {
+		n = 256;
+	}
+	volatile uint32_t *p = (volatile uint32_t *)(void *)(g->kva + off);
+	IOLog("SWEET GPU DUMP %s %#llx: client %u bo %u iova %#llx size %llu, %llu dwords\n", what, va, c, h, g->iova, g->size, n);
+	for (uint64_t j = 0; j < n; j += 8) {
+		IOLog("SWEET GPU DUMP %s +%#05llx: %08x %08x %08x %08x %08x %08x %08x %08x\n", what, j * 4,
+		    p[j], j + 1 < n ? p[j + 1] : 0, j + 2 < n ? p[j + 2] : 0, j + 3 < n ? p[j + 3] : 0,
+		    j + 4 < n ? p[j + 4] : 0, j + 5 < n ? p[j + 5] : 0, j + 6 < n ? p[j + 6] : 0, j + 7 < n ? p[j + 7] : 0);
+	}
+}
