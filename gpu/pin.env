# Single source of truth for the fajita GPU driver.
#
# The GPU Metal->Vulkan->Turnip driver is NOT forked here. It is built from
# ry-diffusion/Bergamota's gpu/metal/ (which is Chlorophyll, already integrated
# on Turnip) at ONE pinned commit, so the driver, the freedreno-sweet libdrm
# shim and the renegade PAC-strip tool are all co-versioned from the same tree.
# No drift between the driver and its shim.
#
# Bump this deliberately (read Bergamota's changes first), then re-run
# gpu/host-check.sh green before dispatching the macOS CI.
BERGAMOTA_REPO=https://github.com/ry-diffusion/Bergamota.git
BERGAMOTA_REF=37a7a7a917fc09945ed2f7d1ae68b84d4525b4cb   # develop @ 2026-10-26
MESA_TAG=mesa-26.2.5
IOS_DEPLOYMENT_TARGET=16.0                                 # fajita = iOS 16.7.16
